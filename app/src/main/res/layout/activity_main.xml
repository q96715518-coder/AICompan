<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A192F"
    android:padding="16dp">

    <TextView
        android:id="@+id/petView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="(•‿•)"
        android:textSize="56sp"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="monospace"
        android:textColor="#64FFDA"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/statusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Система Джарвис готова."
        android:textSize="15sp"
        android:gravity="center"
        android:textColor="#8892B0"
        android:paddingBottom="12dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#112240"
        android:padding="8dp">

        <TextView
            android:id="@+id/chatView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#CCD6F6"
            android:textIsSelectable="true"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Введите запрос..."
            android:textColorHint="#8892B0"
            android:textColor="#CCD6F6"
            android:backgroundTint="#64FFDA"
            android:inputType="text"
            android:maxLines="3"/>

        <Button
            android:id="@+id/sendBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶"
            android:textColor="#0A192F"
            android:backgroundTint="#64FFDA"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/voiceBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎤 Голос"
            android:textColor="#0A192F"
            android:backgroundTint="#64FFDA"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/stopBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔇 Стоп"
            android:textColor="#0A192F"
            android:backgroundTint="#8892B0"/>
    </LinearLayout>

    <GridLayout
        android:id="@+id/quickGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:layout_marginTop="10dp"/>
</LinearLayout>